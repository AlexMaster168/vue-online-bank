{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        "bank": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['version', 'profile']) && newData.child('version').val() === 1"
        }
      }
    }
  }
}
